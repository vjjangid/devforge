# Copy to .env (which is git-ignored) and adjust. Docker Compose reads .env automatically.

# PostgreSQL credentials used by the postgres, api and worker containers.
POSTGRES_DB=devforge
POSTGRES_USER=devforge
POSTGRES_PASSWORD=devforge

# Host ports. 5440 avoids clashing with PostgreSQL installations already on the host (5432-5434).
POSTGRES_PORT=5440
API_PORT=5080
WEB_PORT=8080

# How long each simulated pipeline stage takes (hh:mm:ss).
SIMULATION_STAGE_DELAY=00:00:03
